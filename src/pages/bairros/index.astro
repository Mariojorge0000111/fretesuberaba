---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { BAIRROS, OUTROS_BAIRROS } from '../../data/bairros';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Bairros', item: new URL('/bairros/', Astro.site).href },
  ],
};
---
<Base title="Bairros Atendidos em Uberaba: Frete e Mudança" description="Frete, carreto e mudança em todos os bairros de Uberaba: Centro, Abadia, Fabrício, Mercês, São Benedito, Boa Vista, Leblon, Elza Amui e outros. Veja o seu." schema={schema}>
  <section class="hero-pagina">
    <div class="wrap">
      <nav class="migalhas" aria-label="Você está em"><a href="/">Início</a> / Bairros</nav>
      <h1>Bairros atendidos em Uberaba</h1>
      <p class="lead" style="margin-top:18px">Atendemos a cidade inteira. Os bairros abaixo têm página própria, com o que muda na mudança de cada um.</p>
    </div>
  </section>
  <section class="wrap" style="padding-bottom:96px">
    <div class="cards">
      {BAIRROS.map((b) => (
        <a class="card" href={`/bairros/${b.slug}/`} style="background:var(--branco);border:1px solid var(--linha);border-radius:var(--raio-m);padding:24px">
          <h3>{b.nome}</h3>
          <p>{b.sobre}</p>
        </a>
      ))}
    </div>
    <h2 style="margin:72px 0 20px;font-size:clamp(1.5rem,3vw,2rem)">Também atendemos</h2>
    <p style="color:var(--suave);max-width:820px">{OUTROS_BAIRROS.join(', ')} e os demais bairros e loteamentos de Uberaba.</p>
  </section>
  <Cta />
</Base>
