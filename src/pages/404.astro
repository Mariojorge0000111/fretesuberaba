---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada" description="A página que você procurou não existe ou mudou de endereço." noindex>
  <section class="hero-pagina" style="padding-bottom:120px">
    <div class="wrap">
      <h1>Página não encontrada</h1>
      <p class="lead" style="margin-top:18px">Esse endereço não existe ou mudou. Tente um destes caminhos:</p>
      <ul class="chips" style="margin-top:28px">
        <li><a href="/">Início</a></li><li><a href="/servicos/">Serviços</a></li><li><a href="/bairros/">Bairros</a></li>
        <li><a href="/blog/">Blog</a></li><li><a href="/orcamento/">Pedir orçamento</a></li>
      </ul>
    </div>
  </section>
</Base>
